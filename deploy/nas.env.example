# Copy to /mnt/user/appdata/roadscout/production.env on the NAS.
# For staging, use a different hostname and camera directory.
ROUTING_HOST=roadscout.joswigchert.nl
VALHALLA_NETWORK=home
VALHALLA_BASE_URL=http://Valhalla:8002
TRAEFIK_NETWORK=home
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
CAMERA_DATA_HOST_DIR=/mnt/user/appdata/roadscout/production/cameras
ENABLE_EXPERIMENTAL_ROUTING=0
